{
  "name": "lodgent",
  "private": true,
  "description": "Agent-ready direct booking for independent hotels.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm db:setup && turbo run dev --concurrency=20",
    "build": "turbo run build",
    "test": "turbo run test",
    "e2e": "pnpm --filter @lodgent/web e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @lodgent/db generate",
    "db:migrate": "pnpm --filter @lodgent/db migrate",
    "db:seed": "pnpm --filter @lodgent/scripts seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "agent-sim": "pnpm --filter @lodgent/scripts agent-sim",
    "cdk:synth": "pnpm --filter @lodgent/infra synth",
    "audit": "pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.19.0",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
