# Copy to .env for local development. Every value has a working local default, so
# `pnpm dev` also works without a .env file. Keys left blank use the local fakes.
# Production refuses to start with the development defaults (see packages/application/src/config.ts).

# ---- General -------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
WEB_BASE_URL=http://localhost:3000
# Public API base URL (agents, MCP, OAuth callbacks). The web server can use API_INTERNAL_URL instead.
API_BASE_URL=http://localhost:4000
API_PORT=4000
# Shared secret for server-to-server calls from the web app.
INTERNAL_API_TOKEN=dev-internal-token

# ---- Database ------------------------------------------------------------------
DATABASE_URL=postgres://lodgent:lodgent@localhost:5432/lodgent
DATABASE_SSL=false

# ---- Hotel-user auth -------------------------------------------------------------
# dev = email-only sign-in (local only); cognito = Amazon Cognito managed login.
AUTH_PROVIDER=dev
AUTH_DEV_SECRET=dev-only-auth-secret-change-me-0123456789abcdef
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Web app only: the user pool's managed-login domain (e.g. auth.example.com) and optional client secret.
COGNITO_DOMAIN=
COGNITO_CLIENT_SECRET=

# ---- AWS (local: LocalStack at http://localhost:4566 when using sqs/aws providers) ----
AWS_REGION=eu-central-1
AWS_ENDPOINT_URL=

# Token encryption: local AES key, or AWS KMS envelope encryption.
KMS_PROVIDER=local
LOCAL_KMS_MASTER_KEY=ZGV2LW9ubHktbG9jYWwta21zLWtleS0zMi1ieXRlcyE=
KMS_KEY_ID=

# Background jobs: pg = Postgres table (local), sqs = Amazon SQS.
QUEUE_PROVIDER=pg
SQS_QUEUE_URL=

# Email: smtp (Mailpit locally, UI at http://localhost:8025) or ses.
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Lodgent Bookings <bookings@lodgent.local>

# Root secret for signed tokens (OAuth state, checkout links). Use 32+ random bytes in production.
SIGNING_SECRET=dev-only-signing-secret-0123456789abcdefghij

# ---- Apaleo PMS -------------------------------------------------------------------
# Defaults point at the fake Apaleo server started by `pnpm dev` on :4010.
# Real Apaleo: identity https://identity.apaleo.com, API https://api.apaleo.com, webhooks https://webhook.apaleo.com
APALEO_CLIENT_ID=lodgent-fake-client
APALEO_CLIENT_SECRET=lodgent-fake-secret
APALEO_IDENTITY_URL=http://localhost:4010
APALEO_API_URL=http://localhost:4010
APALEO_WEBHOOK_URL=http://localhost:4010
# Secret path segment of our webhook URL (<API_BASE_URL>/webhooks/apaleo/<token>).
APALEO_WEBHOOK_TOKEN=dev-apaleo-webhook-token
# Optional override of requested scopes (space-separated); must match the Apaleo app registration.
APALEO_SCOPES=
# Channel used for offers and bookings: Ibe (default) or Direct.
APALEO_CHANNEL_CODE=Ibe

# ---- Booking rules --------------------------------------------------------------------
DEFAULT_FEE_BPS=200
HOLD_TTL_MINUTES=15
OFFER_CACHE_TTL_SECONDS=60
OFFER_VALIDITY_MINUTES=30
